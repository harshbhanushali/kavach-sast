# Kavach SAST: configuration. Copy to .env (docker compose reads it) and change what you need.
# Everything is optional; the defaults suit a single machine. See DEPLOYMENT.md for the full guide.

# --- First start -----------------------------------------------------------
# Password for the first administrator ("admin"). At least 10 characters.
# If unset, the account starts on the published default, admin / kavach, and the console
# warns until you change it from the account menu. Set this to skip the default entirely.
# Only used when the database is empty; changing it later does nothing.
KAVACH_SAST_ADMIN_PASSWORD=

# --- Network ---------------------------------------------------------------
# Where docker publishes the port on the host. 127.0.0.1 keeps it private to the
# machine (put a TLS proxy in front, see deploy/); 0.0.0.0 exposes it directly.
KAVACH_SAST_BIND=127.0.0.1
KAVACH_SAST_PORT=8788

# Behind a reverse proxy: how many proxies sit in front (usually 1). Without this
# every client looks like the proxy and per-address limits apply to everyone at once.
KAVACH_SAST_TRUST_PROXY=0
# Serving over HTTPS (directly or through the proxy)? Send Strict-Transport-Security.
KAVACH_SAST_HSTS=false

# --- PDF export --------------------------------------------------------------
# Path to Chrome or Chromium, if it is not in a usual place.
# KAVACH_CHROME=
# Run Chromium without its own sandbox. Only for a host where it cannot start with one
# (unprivileged user namespaces disabled). The report HTML is sanitised and name resolution
# is off, but prefer fixing the host. Not needed in Docker, which is the sandbox.
# KAVACH_CHROME_NO_SANDBOX=1

# --- Capacity --------------------------------------------------------------
# Scans running at once. Each decompiles an app into memory and several GB of disk.
KAVACH_SAST_MAX_SCANS=2
# Scans allowed to wait for a slot; beyond that, uploads are refused as busy.
KAVACH_SAST_MAX_QUEUE=4
# A scan that has not finished after this long is stopped (seconds).
KAVACH_SAST_SCAN_TIMEOUT_SEC=900

# --- Limits ----------------------------------------------------------------
KAVACH_SAST_REQUESTS_PER_MINUTE=600
KAVACH_SAST_LOGIN_FAILURES=20

# --- Data ------------------------------------------------------------------
# Delete scans (and the decompiled sources kept with them) older than this many
# days. 0 keeps everything.
KAVACH_SAST_RETENTION_DAYS=0

# --- Shutdown / logging ----------------------------------------------------
# How long running scans get to finish after SIGTERM (seconds). Keep it below
# stop_grace_period in docker-compose.yml.
KAVACH_SAST_SHUTDOWN_GRACE_SEC=60
KAVACH_SAST_LOG_LEVEL=info
