# nginx in front of Kavach SAST. Terminate TLS here and forward to 127.0.0.1:8788.
# Set KAVACH_SAST_TRUST_PROXY=1 and KAVACH_SAST_HSTS=true on the app.

server {
    listen 443 ssl http2;
    server_name sast.example.com;

    ssl_certificate     /etc/letsencrypt/live/sast.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sast.example.com/privkey.pem;

    # Artifacts are large and streamed straight through.
    client_max_body_size 700m;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 1200s;
    proxy_send_timeout 1200s;

    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name sast.example.com;
    return 301 https://$host$request_uri;
}
